# ─── Founder Lock ─────────────────────────────────────────────────────────────
# Comma-separated tenant IDs that are protected in the Super Admin panel.
# Use the value from the tenants.id column (may be a slug like 'phenomebeauty'
# or a UUID depending on how the tenant was created).
# Protected tenants cannot be suspended or have their plan changed via the SA UI.
# IMPORTANT: Also update this value in Vercel → Settings → Environment Variables.
VITE_FOUNDER_TENANT_IDS=phenomebeauty

# ─── Supabase ─────────────────────────────────────────────────────────────────
# These are already hardcoded in src/integrations/supabase/client.ts
# but listed here for reference / local override if needed.
# VITE_SUPABASE_URL=https://kjibbbuceipnialfgflt.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here
